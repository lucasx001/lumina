# Expo embeds EXPO_PUBLIC_* values in the app bundle. Never put secrets in these variables.
# Use a LAN address when testing on a physical device; localhost only reaches the device itself.
EXPO_PUBLIC_API_URL=http://192.18.0.1:3000

# Clerk Dashboard > API keys > Publishable key.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
