{
  "name": "@lumina/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "build": "expo export --platform all",
    "eas:init": "bunx eas-cli@latest init",
    "eas:development": "bunx eas-cli@latest build --platform android --profile development --no-wait",
    "eas:development:reuse": "bunx eas-cli@latest build:dev --platform android --profile development --skip-bundler",
    "eas:preview": "bunx eas-cli@latest build --platform android --profile preview --no-wait",
    "eas:production": "bunx eas-cli@latest build --platform android --profile production --no-wait",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@babel/runtime": "^7",
    "@clerk/expo": "^4.0.3",
    "@expo/ui": "~56.0.24",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@lingui/core": "^6.6.0",
    "@lingui/react": "^6.6.0",
    "@lumina/i18n": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~56.0.18",
    "expo-auth-session": "~56.0.16",
    "expo-constants": "~56.0.22",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.24",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-glass-effect": "~56.0.4",
    "expo-image": "~56.0.11",
    "expo-image-picker": "~56.0.22",
    "expo-linking": "~56.0.16",
    "expo-localization": "~56.0.6",
    "expo-media-library": "~56.0.10",
    "expo-router": "~56.2.17",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.23",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-toast-message": "^2.4.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "^6.6.0",
    "@react-native/jest-preset": "0.85.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "jest-expo": "~56.0.5",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/setup-i18n.ts"
    ],
    "testMatch": [
      "<rootDir>/src/__tests__/**/*.test.ts",
      "<rootDir>/src/__tests__/**/*.test.tsx"
    ],
    "transform": {
      "^.+\\.mjs$": "babel-jest"
    },
    "transformIgnorePatterns": []
  }
}
