#: apps/landing/src/app/[locale]/page.tsx
msgid "Turn a feeling into your wallpaper."
msgstr "把一种感受，变成你的壁纸。"

#: apps/landing/src/app/[locale]/page.tsx
msgid "Meet a world you love every time you unlock."
msgstr "每次解锁，都遇见一个喜欢的世界。"

#: apps/landing/src/app/[locale]/page.tsx
msgid "YOUR SCREEN, YOUR WORLD"
