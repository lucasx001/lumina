{
  "name": "@lumina/workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "vp run --filter=@lumina/i18n compile && vp check",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "dev": "turbo run dev --filter=@lumina/mobile --filter=@lumina/server --filter=@lumina/landing",
    "mobile:android": "bun --cwd=apps/mobile run android",
    "test": "vp run test:all",
    "test:server": "vp test run apps/server/src",
    "build": "vp run build:all",
    "db:generate": "bun --cwd=apps/server run prisma:generate",
    "db:migrate": "bun --cwd=apps/server run prisma:migrate",
    "db:deploy": "bun --cwd=apps/server run prisma:deploy",
    "db:reset": "bun --cwd=apps/server run prisma:reset",
    "db:seed": "bun --cwd=apps/server run prisma:seed",
    "db:push": "bun --cwd=apps/server run prisma:push",
    "db:status": "bun --cwd=apps/server run prisma:status",
    "db:studio": "bun --cwd=apps/server run prisma:studio",
    "eas:init": "cd apps/mobile && bun run eas:init",
    "eas:development": "cd apps/mobile && bun run eas:development",
    "eas:development:reuse": "cd apps/mobile && bun run eas:development:reuse",
    "eas:preview": "cd apps/mobile && bun run eas:preview",
    "eas:production": "cd apps/mobile && bun run eas:production",
    "staged": "vp staged",
    "setup:hooks": "vp config --no-agent",
    "i18n:extract": "vp run --filter=@lumina/i18n extract",
    "i18n:compile": "vp run --filter=@lumina/i18n compile",
    "i18n:check": "vp run --filter=@lumina/i18n extract && git diff --exit-code -- packages/i18n/locales && vp run --filter=@lumina/i18n compile"
  },
  "devDependencies": {
    "@voidzero-dev/vite-plus-core": "^0.2.6",
    "turbo": "^2.10.11",
    "vite-plus": "^0.2.6",
    "vitest": "4.1.10"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest"
  },
  "packageManager": "bun@1.3.11"
}
